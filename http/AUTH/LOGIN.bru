meta {
  name: LOGIN
  type: http
  seq: 1
}

post {
  url: {{host}}/auth/login
  body: none
  auth: basic
}

auth:basic {
  username: {{email}}
  password: {{password}}
}

script:post-response {
  const headers = res.getHeaders();
  
  const setCookie = headers["set-cookie"];
  
  if (setCookie) {
    bru.setVar("access_token_cookie", setCookie);
  }
}
