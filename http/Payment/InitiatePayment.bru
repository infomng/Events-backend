meta {
  name: Initiate Payment
  type: http
  seq: 1
}

post {
  url: {{host}}/payments/initiate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "bookingId": "{{bookingId}}",
    "paymentMethod": "CREDIT_CARD",
    "paymentGateway": "STRIPE",
    "metadata": "{\"customerId\": \"12345\"}"
  }
}

vars:pre-request {
  bookingId:
}
