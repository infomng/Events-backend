meta {
  name: AddItemToCart
  type: http
  seq: 1
}

post {
  url: {{host}}/cart/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "eventId": "{{eventId}}",
    "priceCategoryId": "{{priceCategoryId}}",
    "quantity": 2
  }
}

vars:pre-request {
  eventId: a1177000-9fa6-4070-aafe-2ff1b2854892
  priceCategoryId: 8c6b17bd-0679-4089-9472-b528d4d656bb
}
